---
import Layout from "../../layouts/Layout.astro";
import { getAllPosts, getMusicUrls, getSeriesName } from "../../lib/microcms";

export async function getStaticPaths() {
  const posts = await getAllPosts({ fields: "id" });

  return posts.map((content: any) => ({
    params: { id: content.id },
  }));
}

const { id } = Astro.params;

// 全記事の取得（シリーズ情報の判定用）
const allPosts = await getAllPosts();

const blog = allPosts.find((item: any) => item.id === id);
const musicUrls = getMusicUrls(blog);
const seriesName = getSeriesName(blog);

// シリーズ情報（前後話）を取得
let seriesEpisodes: any[] = [];
let nextEpisode: any = null;
let prevEpisode: any = null;

if (seriesName) {
  seriesEpisodes = allPosts
    .filter((novel: any) => getSeriesName(novel) === seriesName)
    .sort((a: any, b: any) => new Date(a.publishedAt).getTime() - new Date(b.publishedAt).getTime());

  const currentIndex = seriesEpisodes.findIndex((item: any) => item.id === id);
  if (currentIndex !== -1) {
    if (currentIndex < seriesEpisodes.length - 1) {
      nextEpisode = seriesEpisodes[currentIndex + 1];
    }
    if (currentIndex > 0) {
      prevEpisode = seriesEpisodes[currentIndex - 1];
    }
  }
}

// YouTube埋め込みURLへの変換
const musicEmbedUrls = musicUrls.map((url: string) => {
  try {
    const urlObj = new URL(url);
    if (urlObj.hostname.includes('youtube.com') && urlObj.searchParams.has('v')) {
      return `https://www.youtube.com/embed/${urlObj.searchParams.get('v')}`;
    }
    if (urlObj.hostname === 'youtu.be') {
      return `https://www.youtube.com/embed${urlObj.pathname}`;
    }
    return url;
  } catch (e) {
    return url;
  }
});
---

<Layout title={`${blog?.title || ''} — note.`} wide={true}>
  <div class="novel-slider-wrapper">
    <!-- メニュー開閉用フラグ（非表示） -->
    <input type="checkbox" id="menu-drawer-toggle" class="drawer-checkbox" checked />

    <!-- 据え置きヘッダー：一覧に戻る + MENU（常に表示） -->
    <div class="fixed-header-row">
      <a href="/" class="back-link">← 一覧に戻る</a>
      <label for="menu-drawer-toggle" class="menu-toggle-btn">
        <span class="toggle-arrow">▶</span>
        <span class="menu-label">MENU（<span class="state-text closed">開く</span><span class="state-text open">閉じる</span>）</span>
      </label>
    </div>

    <div class="stage-container">
      <aside class="sidebar-layer">
        <div class="sidebar-inner">
          <!-- SERIES -->
          {seriesName && (
            <div class="sidebar-group">
              <div class="group-title">SERIES</div>
              <a href={`/series/${encodeURIComponent(seriesName)}`} class="series-title-link">
               {seriesName}（全{seriesEpisodes.length}話）
              </a>
              <div class="episode-nav">
                {prevEpisode && (
                  <a href={`/novel/${prevEpisode.id}`} class="episode-link">
                    ◀ 前の話：{prevEpisode.title}
                  </a>
                )}
                {nextEpisode && (
                  <a href={`/novel/${nextEpisode.id}`} class="episode-link next">
                    ▶ 次の話：{nextEpisode.title}
                  </a>
                )}
              </div>
            </div>
          )}

          <!-- BGM / 参考動画（縦1列） -->
          {musicEmbedUrls.length > 0 && (
            <div class="sidebar-group">
              <div class="group-title">BGM / 参考動画</div>
              <div class="music-vertical-list">
                {musicEmbedUrls.map((url: string) => (
                  <iframe 
                    src={url} 
                    class="music-iframe" 
                    frameborder="0" 
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                    allowfullscreen>
                  </iframe>
                ))}
              </div>
            </div>
          )}
        </div><br/>
        {blog?.memo && (
            <div class="sidebar-group">
              <div class="group-title">MEMO</div>
              <div class="memo-content" set:html={blog.memo} />
            </div>)}
      </aside>

      <!-- ② 小説タイトル・本文（表側に覆いかぶさり、MENUクリックで右へスライド） -->
      <main class="main-content-layer">
        <div class="title-row">
          <h1 class="novel-title">{blog?.title}</h1>
          {seriesName && (prevEpisode || nextEpisode) && (
            <div class="episode-nav-inline top">
              {prevEpisode && <a href={`/novel/${prevEpisode.id}`}>←前話</a>}
              {nextEpisode && <a href={`/novel/${nextEpisode.id}`}>次話→</a>}
            </div>
          )}
        </div>
        <hr class="divider" />
        <div class="novel-body" set:html={blog?.text} />
        {seriesName && (prevEpisode || nextEpisode) && (
          <div class="episode-nav-inline bottom">
            {prevEpisode && <a href={`/novel/${prevEpisode.id}`}>←前話</a>}
            {nextEpisode && <a href={`/novel/${nextEpisode.id}`}>次話→</a>}
          </div>
        )}
      </main>
    </div>
  </div>
</Layout>

<style>
  .drawer-checkbox {
    display: none;
  }

  .novel-slider-wrapper {
    position: relative;
    width: 100%;
    overflow-x: hidden;
  }
  .memo-content {
    font-size: 0.7rem;
    line-height: 1.6;
    color: var(--gray-bright, #8b8f96);
    white-space: pre-line;
    word-break: break-word;
  }

  /* --- 据え置きヘッダー行（一覧に戻る + MENU） --- */
  /* このページだけヘッダー罫線とのアキを詰める */
  :global(.page) {
    padding-top: 16px !important;
  }

  .fixed-header-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    margin-bottom: 12px;
    position: relative;
    z-index: 10;
  }

  .menu-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    color: var(--gray-bright, #ccc);
    cursor: pointer;
    user-select: none;
    padding: 4px 0;
    transition: color 0.2s;
  }

  .menu-toggle-btn:hover {
    color: #fff;
  }

  .toggle-arrow {
    font-size: 0.7rem;
    display: inline-block;
    transition: transform 0.3s ease;
  }

  /* 開いた時に矢印を回転（チェックボックスは fixed-header-row の兄弟要素なので ~ で辿る） */
  .drawer-checkbox:checked ~ .fixed-header-row .toggle-arrow {
    transform: rotate(90deg);
  }

  /* 開閉状態に応じて「開く」「閉じる」の表記を切り替え（両方いったん非表示にしてから、該当する方だけ表示） */
  .state-text {
    display: none;
  }
  .drawer-checkbox:checked ~ .fixed-header-row .state-text.open {
    display: inline;
  }
  .drawer-checkbox:not(:checked) ~ .fixed-header-row .state-text.closed {
    display: inline;
  }

  /* --- レイアウトステージ --- */
  .stage-container {
    position: relative;
    width: 100%;
    min-height: 80vh;
  }

  /* ① サイドバー（裏レイヤー）。幅は下の main-content-layer の translateX と必ず同じ値にする */
  .sidebar-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 260px;
    height: 100%;
    z-index: 1;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  /* メニューが開いたら表示を有効化 */
  .drawer-checkbox:checked ~ .stage-container .sidebar-layer {
    opacity: 1;
    pointer-events: auto;
  }

  .sidebar-inner {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-right: 15px;
  }

  .sidebar-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .group-title {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: var(--gray-dim, #888);
  }

  .back-link {
    font-size: 0.85rem;
    color: var(--gray, #aaa);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover {
    color: #fff;
  }

  .series-title-link {
    font-size: 0.85rem;
    color: #fff;
    text-decoration: none;
    line-height: 1.4;
  }

  .episode-nav {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 4px;
  }

  .episode-link {
    font-size: 0.8rem;
    color: #888;
    text-decoration: none;
    line-height: 1.3;
  }
  .episode-link:hover {
    color: #fff;
  }
  .episode-link.next {
    color: #4da6ff;
  }

  /* 動画（縦1列） */
  .music-vertical-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .music-iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    border: 1px solid var(--line, #333);
  }

  /* ② 小説本文（表レイヤー / 最初は全体を覆い隠す） */
  .main-content-layer {
    position: relative;
    z-index: 2;
    width: 100%;
    background: var(--bg, #0a0a0a); /* 背景色で下のサイドバーを覆う */
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), width 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* メニューが開いた時：サイドバー幅(260px)ぶん右へスライド。上のsidebar-layerの幅と必ず一致させる */
  .drawer-checkbox:checked ~ .stage-container .main-content-layer {
    transform: translateX(calc(260px + 24px));
    width: calc(100% - 260px - 24px);
  }

  .title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }

  .novel-title {
    font-size: 1.3rem;
    font-weight: normal;
    margin-top: 0;
    margin-bottom: 12px;
  }

  .episode-nav-inline {
    display: flex;
    gap: 20px;
    flex: none;
  }
  .episode-nav-inline a {
    font-size: 0.8rem;
    color: var(--gray-bright, #ccc);
    white-space: nowrap;
  }
  .episode-nav-inline a:hover {
    color: #fff;
  }
  .episode-nav-inline.bottom {
    justify-content: center;
    margin-top: 40px;
    gap: 40px;
  }
  .episode-nav-inline.bottom a {
    font-size: 0.85rem;
  }

  .divider {
    border: none;
    border-top: 1px solid var(--line, #333);
    margin-bottom: 28px;
  }

  .novel-body {
    line-height: 1.8;
    font-size: 1rem;
    color: var(--ink, #eee);
  }

  .novel-body :global(p) {
    margin: 0 0 1em 0;
  }

  /* モバイル対応（画面が狭い時はサイドバーを画面幅の70%にし、その分だけスライド量も揃える） */
  @media (max-width: 768px) {
    .sidebar-layer {
      width: 70vw;
    }
    .drawer-checkbox:checked ~ .stage-container .main-content-layer {
      transform: translateX(calc(70vw + 16px));
      width: 100%;
    }
  }
</style>