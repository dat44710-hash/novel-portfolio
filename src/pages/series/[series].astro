---
import Layout from "../../layouts/Layout.astro";
import { client, getSeriesName } from "../../lib/microcms";

export async function getStaticPaths() {
  const response = await client.get({ endpoint: "toukou" });
  const novels = response.contents;

  const seriesNames = new Set<string>();
  novels.forEach((novel: any) => {
    const name = getSeriesName(novel);
    if (name) seriesNames.add(name);
  });

  return Array.from(seriesNames).map((name) => ({
    params: { series: name },
  }));
}

const { series } = Astro.params;

const response = await client.get({ endpoint: "toukou" });
const episodes = response.contents
  .filter((novel: any) => getSeriesName(novel) === series)
  // 話数フィールドが無い前提なので、投稿日時が古い方から第1話とする
  .sort((a: any, b: any) => new Date(a.publishedAt).getTime() - new Date(b.publishedAt).getTime());

const category = episodes.length > 0 && episodes[0].category ? episodes[0].category[0] : "";
---

<Layout title={`${series} — note.`}>
  <a href={category ? `/category/${category}` : "/"} class="back-link">← 一覧に戻る</a>
  <h1>{series}</h1>
  <p class="page-lead">全{episodes.length}話</p>

  <ul class="tracklist">
    {episodes.map((novel: any, i: number) => (
      <li>
        <span class="tag">第{i + 1}話</span>
        <a href={`/novel/${novel.id}`}>{novel.title}</a>
      </li>
    ))}
  </ul>
</Layout>

<style>
  /* 1. 「← 一覧に戻る」とタイトルの距離を狭める */
  .back-link {
    margin-bottom: 12px !important; /* 元は32px */
  }

  /* 2. シリーズタイトルと「全〇話」の距離を狭める */
  h1 {
    margin-bottom: 0px !important; /* 元は8px */
  }

  /* 3. 「全〇話」と下のエピソード一覧（罫線）の距離を狭める */
  .page-lead {
    margin-bottom: 24px !important; /* 元は48px */
  }

  /* 4. （おまけ）各話の行の上下の隙間も少し狭めました */
  .tracklist li {
    padding: 12px 4px !important; /* 元は16px */
  }
</style>